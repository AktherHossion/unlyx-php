{
    "name": "unlyx/unlyx-php",
    "description": "Official PHP SDK for the Unlyx REST API v1 (account, services, orders, webhooks, usage).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "unlyx",
        "imei",
        "unlock",
        "reseller",
        "gsm",
        "api",
        "sdk",
        "webhooks"
    ],
    "authors": [
        {
            "name": "Unlyx"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Unlyx\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Unlyx\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "homepage": "https://unlyx.com/developers",
    "support": {
        "issues": "https://github.com/AktherHossion/unlyx-php/issues",
        "source": "https://github.com/AktherHossion/unlyx-php",
        "docs": "https://unlyx.com/developers"
    }
}
